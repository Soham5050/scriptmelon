# ScriptMelon configuration — copy to `.env` and edit.
#   cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed: it holds your HF token.
# Every value here is a safe default or a placeholder.
# Anything you leave unset falls back to the default in config.py.

# ---------------------------------------------------------------------------
# ASR (speech recognition)
# ---------------------------------------------------------------------------
TRANSCRIBE_BACKEND=whisperx
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_BEAM_SIZE=5
FASTER_WHISPER_BEST_OF=5
# Leave unset to let the GPU tier pick for you (recommended). Setting it here
# pins the value and overrides the automatic choice.
# FASTER_WHISPER_COMPUTE_TYPE=float16
FASTER_WHISPER_CONDITION_ON_PREVIOUS_TEXT=false

ASR_AUDIO_PREPROCESS_ENABLED=true
ASR_MIN_AVG_LOGPROB=-1.0
ASR_REFINE_LOW_CONF_SEGMENTS_ENABLED=true
ASR_REFINE_MAX_SEGMENTS=12
ASR_REFINE_MARGIN_SEC=0.25
ASR_SKIP_SUSPICIOUS_SEGMENTS=false
ASR_SKIP_SUSPICIOUS_MAX_RATIO=0.35

# ---------------------------------------------------------------------------
# Speaker diarization (multi-voice dubbing, --multi_voice)
# ---------------------------------------------------------------------------
# Diarization needs a HuggingFace token AND acceptance of the gated model terms:
#   1. Create a token: https://huggingface.co/settings/tokens
#   2. Accept terms:   https://hf.co/pyannote/speaker-diarization-community-1
# Without this, --multi_voice warns and dubs everyone with a single voice.
HF_TOKEN=
WHISPERX_DIARIZE_ENABLED=false
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Assign the nearest speaker to segments with no diarization overlap, so every
# segment gets dubbed rather than silently dropped.
DIARIZATION_FILL_NEAREST=true
# Upper bound on distinct cloned voices; extra speakers reuse the default voice.
DIARIZATION_MAX_SPEAKERS=8
# Minimum clean speech per speaker before we trust it enough to clone.
DIARIZATION_MIN_SPEAKER_SECONDS=1.5

# ---------------------------------------------------------------------------
# Translation
# ---------------------------------------------------------------------------
TRANSLATION_BACKEND=indictrans2
TRANSLATION_ENABLE_SMART_ROUTING=true
TRANSLATION_STRICT_QUALITY=false

# ---------------------------------------------------------------------------
# TTS
# ---------------------------------------------------------------------------
# auto = route by target language (Indic -> IndicF5, everything else -> Qwen3).
# Pinning this to qwen3 or indicf5 disables that routing, which is what you want
# for an A/B and NOT what you want by default: Qwen3-TTS has no Indian language,
# so a pinned qwen3 makes every Indic dub sound fluent and mean nothing.
TTS_BACKEND=auto

QWEN3_LOCAL_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QWEN3_LOCAL_DEVICE=cuda:0
QWEN3_LOCAL_DTYPE=float16
QWEN3_LOCAL_USE_FLASH_ATTN=false
QWEN3_USE_REF_TEXT=false
QWEN3_LOCAL_TEMPERATURE=0.7
QWEN3_EXPRESSIVE_ENGLISH_ENABLED=true
QWEN3_EXPRESSIVE_ENGLISH_BOOST=1.0
QWEN3_LOCAL_MAX_CHARS_PER_CHUNK=80
QWEN3_LOCAL_MAX_NEW_TOKENS=2048
QWEN3_CPU_MAX_CHARS_PER_CHUNK=40

# IndicF5 (Indic-language TTS). Gated on HuggingFace: accept the terms at
# https://huggingface.co/ai4bharat/IndicF5 and set HF_TOKEN above, or Indic runs
# fail at the TTS stage. Install it with the --no-deps step from the README.
INDICF5_MODEL_ID=ai4bharat/IndicF5
# Pinned snapshot. trust_remote_code below executes model.py from this repo, so
# the revision is pinned rather than tracking main.
INDICF5_REVISION=ba85abedf18dc479a447eaa0eccbd76ab78a47d5
INDICF5_TRUST_REMOTE_CODE=true
INDICF5_DEVICE=cuda:0
INDICF5_OUTPUT_SR=24000
# When a reference clip has no transcript, fall back to IndicF5's bundled prompt
# (correct pronunciation, loses the speaker's voice). Set false to pass an empty
# ref_text instead, which makes IndicF5 load whisper-large-v3-turbo (~1.6 GB
# VRAM) mid-TTS to transcribe the clip itself.
INDICF5_USE_BUNDLED_PROMPT=true

TTS_DURATION_MATCH_MIN_SPEED=0.80
TTS_DURATION_MATCH_MAX_SPEED=1.25
TTS_DURATION_MATCH_EN_MAX_SPEED=1.15
TTS_DURATION_LOCK_ENABLED=true
TTS_DURATION_LOCK_TOLERANCE_SEC=0.06
TTS_DURATION_FORCE_EXACT_FIT=true
TTS_MIN_FREE_VRAM_GB=2.0
# Length of each voice-cloning reference clip.
TTS_SPEAKER_REF_MAX_SECONDS=6.0
TTS_UNLOAD_MODEL_BETWEEN_CHUNKS=false
TTS_REF_TEXT=

# ---------------------------------------------------------------------------
# GPU tiers and quantization
# ---------------------------------------------------------------------------
ADAPTIVE_RUNTIME_ENABLED=true
# 0 = derive the per-process memory fraction from the detected GPU tier.
GPU_MEMORY_FRACTION=0
# Tier boundaries in GB. <=6.5 is "ultra_low" (6 GB cards: RTX 2060/3050),
# where quantization is applied most aggressively.
ULTRA_LOW_VRAM_THRESHOLD_GB=6.5
LOW_VRAM_THRESHOLD_GB=7
MID_VRAM_THRESHOLD_GB=14
HIGH_VRAM_THRESHOLD_GB=32

# Quantization. "auto" picks per GPU tier and is what you want unless you are
# debugging. Explicit values always win over the automatic choice.
#   ASR_COMPUTE_TYPE        : CTranslate2 type. auto -> int8_float16 on small
#                             cards (near-fp16 quality at ~half the VRAM, so a
#                             6 GB card can run large-v3 instead of a weaker model)
#   TRANSLATION_QUANTIZATION: none | 8bit | 4bit (needs bitsandbytes)
#   TTS_QUANTIZATION        : none | 8bit. Do NOT use 4bit — it wrecks prosody.
ASR_COMPUTE_TYPE=auto
TRANSLATION_QUANTIZATION=auto
TTS_QUANTIZATION=auto

# Chunk sizes used on 6 GB cards to keep TTS inside the memory budget.
QWEN3_ULTRA_LOW_VRAM_MAX_CHARS_PER_CHUNK=40
QWEN3_ULTRA_LOW_VRAM_BATCH_SIZE=1
QWEN3_ULTRA_LOW_VRAM_CLEANUP_EVERY=1

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
